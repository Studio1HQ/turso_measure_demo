# --- Turso Sync (https://app.turso.tech) ---
# turso db create syncnote
# turso db show syncnote --url
# turso db tokens create syncnote
EXPO_PUBLIC_TURSO_URL=libsql://syncnote-<your-org>.turso.io
EXPO_PUBLIC_TURSO_AUTH_TOKEN=

# --- Measure (https://measure.sh -> create app -> API key) ---
# Baked into the native build by the @measuresh/react-native config plugin.
# Re-run `npx expo prebuild --clean` after changing these.
MEASURE_API_KEY=
MEASURE_API_URL=https://ingest.measure.sh
